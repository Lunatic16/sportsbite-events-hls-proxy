# SportsRelay environment template — copy to .env when using docker compose:
#   cp .env.example .env
#
# All values are optional; defaults keep the proxy working out of the box.

# Additional upstream hosts the HLS relay may fetch from, beyond the built-in
# allowlist (sportsbite.org, embed.sportsbite.org and *.cr7goated.site).
# Comma-separated. Only needed if SportsBite adds new segment CDNs.
HLS_EXTRA_ALLOWED_HOSTS=

# Upstream schedule cache TTL in milliseconds (default 60000 = 60s,
# matching the upstream 60 req/min rate limit).
SCHEDULE_CACHE_TTL_MS=60000

# Absolute base URL written into /playlist.m3u8 channel entries.
# Leave empty to auto-detect from request headers (x-forwarded-host/proto or
# the request host). Set it when running behind a reverse proxy that the
# auto-detection cannot see, e.g. PLAYLIST_BASE_URL=https://relay.example.com
PLAYLIST_BASE_URL=
